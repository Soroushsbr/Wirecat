<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/wcColorBackground"
    android:paddingHorizontal="16dp">

    <include android:id="@+id/toolbarBack" layout="@layout/toolbar_back" />

    <TextView
        android:id="@+id/textDetailSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_stroke"
        android:padding="16dp"
        android:textColor="?attr/wcColorTextPrimary"
        android:textSize="14sp"
        android:text="Total: -- \u2022 Duration: --" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_card_stroke"
        android:padding="4dp">

        <TextView
            android:id="@+id/tabDataUsage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="10dp"
            android:textStyle="bold"
            android:textSize="13sp"
            android:text="@string/history_tab_data" />

        <TextView
            android:id="@+id/tabLogs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="10dp"
            android:textStyle="bold"
            android:textSize="13sp"
            android:text="@string/history_tab_logs" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/detailLogSearchBar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card_stroke"
        android:paddingHorizontal="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_search"
            app:tint="?attr/wcColorTextSecondary"
            android:contentDescription="@null" />

        <EditText
            android:id="@+id/editDetailLogSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="@string/log_search_hint"
            android:textColorHint="?attr/wcColorTextSecondary"
            android:textColor="?attr/wcColorTextPrimary"
            android:textSize="13sp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:singleLine="true" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDetailApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDetailLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textDetailLogsEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:textColor="?attr/wcColorTextSecondary"
        android:visibility="gone"
        android:text="@string/history_no_packets_monitor" />

</LinearLayout>
